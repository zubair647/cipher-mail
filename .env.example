# Copy to .env and fill in once you've registered the standalone Cipher Mail app
# in Azure (multi-tenant, delegated Mail.Send). See README "Microsoft setup".

# Azure AD application (client) ID of the Cipher Mail registration.
VITE_MS_CLIENT_ID=

# "common" = multi-tenant (any user signs in with their own account). Default.
VITE_MS_AUTHORITY=common

# "true" simulates sending locally (no real mail). Leave blank to send for real
# once VITE_MS_CLIENT_ID is set. With no client id the app forces mock mode so
# `npm run dev` works out of the box.
VITE_MOCK_SEND=
